# Projet Supabase.
#
# Aucun préfixe NEXT_PUBLIC_ : l'application ne contacte Supabase que
# depuis le serveur (composants serveur, Server Actions, proxy), donc
# aucune de ces valeurs n'est embarquée dans le bundle JavaScript.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Seule adresse autorisée à se connecter à l'app.
# Toute autre adresse est refusée côté serveur ET déconnectée par le proxy.
OWNER_EMAIL=

# Facultatif — origine publique du site, utilisée par le lien de
# connexion envoyé par email. Vercel la fournit sinon automatiquement.
SITE_URL=
